generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model expense_participants {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expense_id   String   @db.Uuid
  user_id      String   @db.Uuid
  share_amount   Decimal  @db.Decimal(12, 2)
  settled_amount Decimal  @default(0) @db.Decimal(12, 2)
  is_settled     Boolean  @default(false)
  expenses     expenses @relation(fields: [expense_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([expense_id, user_id], map: "uq_expense_participant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model expenses {
  id                               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                            String                 @db.VarChar(255)
  description                      String?
  amount                           Decimal                @db.Decimal(12, 2)
  paid_by                          String                 @db.Uuid
  group_id                         String?                @db.Uuid
  category                         String                 @default("general") @db.VarChar(50)
  expense_date                     DateTime               @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_by                       String                 @db.Uuid
  created_at                       DateTime?              @default(now()) @db.Timestamp(6)
  expense_participants             expense_participants[]
  users_expenses_created_byTousers users                  @relation("expenses_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups                           groups?                @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users_expenses_paid_byTousers    users                  @relation("expenses_paid_byTousers", fields: [paid_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model friend_requests {
  id                                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id                                String    @db.Uuid
  receiver_id                              String    @db.Uuid
  status                                   String    @default("pending") @db.VarChar(20)
  created_at                               DateTime? @default(now()) @db.Timestamp(6)
  users_friend_requests_receiver_idTousers users     @relation("friend_requests_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_friend_requests_sender_idTousers   users     @relation("friend_requests_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sender_id, receiver_id], map: "uq_friend_request")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model friendships {
  id                                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_a_id                          String    @db.Uuid
  user_b_id                          String    @db.Uuid
  created_at                         DateTime? @default(now()) @db.Timestamp(6)
  users_friendships_user_a_idTousers users     @relation("friendships_user_a_idTousers", fields: [user_a_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_friendships_user_b_idTousers users     @relation("friendships_user_b_idTousers", fields: [user_b_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_a_id, user_b_id], map: "uq_friendship")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model group_members {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id  String    @db.Uuid
  user_id   String    @db.Uuid
  joined_at DateTime? @default(now()) @db.Timestamp(6)
  groups    groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, user_id], map: "uq_group_member")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model groups {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String          @db.VarChar(100)
  created_by    String          @db.Uuid
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  expenses      expenses[]
  group_members group_members[]
  users         users           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  settlements   settlements[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model settlements {
  id                                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payer_id                             String    @db.Uuid
  receiver_id                          String    @db.Uuid
  group_id                             String?   @db.Uuid
  amount                               Decimal   @db.Decimal(12, 2)
  note                                 String?
  status                               String    @default("confirmed") @db.VarChar(20)
  created_at                           DateTime? @default(now()) @db.Timestamp(6)
  groups                               groups?   @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users_settlements_payer_idTousers    users     @relation("settlements_payer_idTousers", fields: [payer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_settlements_receiver_idTousers users     @relation("settlements_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                                                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                               String                 @db.VarChar(100)
  email                                              String                 @unique @db.Citext
  password_hash                                      String
  avatar_url                                         String?
  created_at                                         DateTime?              @default(now()) @db.Timestamp(6)
  expense_participants                               expense_participants[]
  expenses_expenses_created_byTousers                expenses[]             @relation("expenses_created_byTousers")
  expenses_expenses_paid_byTousers                   expenses[]             @relation("expenses_paid_byTousers")
  friend_requests_friend_requests_receiver_idTousers friend_requests[]      @relation("friend_requests_receiver_idTousers")
  friend_requests_friend_requests_sender_idTousers   friend_requests[]      @relation("friend_requests_sender_idTousers")
  friendships_friendships_user_a_idTousers           friendships[]          @relation("friendships_user_a_idTousers")
  friendships_friendships_user_b_idTousers           friendships[]          @relation("friendships_user_b_idTousers")
  group_members                                      group_members[]
  groups                                             groups[]
  settlements_settlements_payer_idTousers            settlements[]          @relation("settlements_payer_idTousers")
  settlements_settlements_receiver_idTousers         settlements[]          @relation("settlements_receiver_idTousers")
}
